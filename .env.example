# LLM provider: "azure", "anthropic", or "google". Optional — inferred from
# which API key is set below if omitted (Azure first, then Anthropic, then
# Google).
# AI_PROVIDER=azure

# Azure OpenAI (AI_PROVIDER=azure)
# Set EITHER the full endpoint URL (from Azure AI Foundry / portal, e.g.
# https://my-resource.cognitiveservices.azure.com) OR the bare resource name.
# Deployment recommendation: gpt-5.4-mini (best cost/quality for extraction +
# classification); gpt-5.4 for maximum accuracy; gpt-5.4-nano or
# model-router for lowest cost. AZURE_OPENAI_DEPLOYMENT is YOUR deployment
# name in Azure AI Foundry, which may differ from the model name; the model
# selector assumes deployments are named after their models (gpt-5.4, ...).
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_RESOURCE_NAME=your-resource-name  # alternative to ENDPOINT
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_API_VERSION=  # optional, SDK default if unset

# Optional second Azure resource, for deployments that live elsewhere.
# AZURE_OPENAI_2_DEPLOYMENTS names them (comma-separated deployment names);
# those route to the _2 endpoint/key, everything else to the primary above.
# AZURE_OPENAI_2_ENDPOINT=https://your-other-resource.cognitiveservices.azure.com
# AZURE_OPENAI_2_API_KEY=your-other-api-key
# AZURE_OPENAI_2_DEPLOYMENTS=model-router

# Anthropic (AI_PROVIDER=anthropic)
# Model recommendation: claude-opus-4-8 (default — most capable);
# claude-sonnet-4-6 for a cheaper/faster balance; claude-haiku-4-5 budget.
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini (AI_PROVIDER=google)
# Model recommendation: gemini-3.5-flash (default — stable, strong, fast);
# gemini-3.1-pro-preview for maximum accuracy (preview ID);
# gemini-3.1-flash-lite for budget runs.
# GOOGLE_GENERATIVE_AI_API_KEY=your-api-key
# GOOGLE_MODEL=gemini-3.5-flash

# Vercel AI Gateway (AI_PROVIDER=gateway) — one key, hundreds of models in
# "creator/model" form; browse https://vercel.com/ai-gateway/models.
# AI_GATEWAY_MODELS picks which appear in the selector (comma-separated).
# AI_GATEWAY_API_KEY=your-gateway-key
# AI_GATEWAY_MODELS=xai/grok-4.3
