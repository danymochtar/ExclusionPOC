# LLM provider: "azure" or "anthropic". Optional — inferred from which API
# key is set below if omitted.
# AI_PROVIDER=azure

# Azure OpenAI (AI_PROVIDER=azure)
AZURE_OPENAI_RESOURCE_NAME=your-resource-name
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=  # optional, SDK default if unset

# Anthropic (AI_PROVIDER=anthropic — or leave AI_PROVIDER unset; the provider
# is inferred from whichever API key is configured, Azure winning if both are)
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-6
